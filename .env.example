# Copy to `.env` and fill in secrets. Backend loads `.env` from the project root.

# --- Runtime ---
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
# SKIP_DB_WAIT=1
# TRUST_PROXY=1
# CORS_ORIGIN=https://your-app.example.com,https://other.example.com
# DB_CONNECT_MAX_ATTEMPTS=15
# DB_CONNECT_INTERVAL_MS=1000

# --- Postgres (docker-compose: host port 5434) ---
DATABASE_URL=postgresql://askmak:askmak_dev@localhost:5434/askmak
# --- Auth ---
# Generate strong random strings for production.
JWT_SECRET=change-me-use-long-random-string
COOKIE_SECRET=change-me-another-long-random-string-for-signed-cookies
# COOKIE_SECURE=true

# --- OpenAI (required for chat, embeddings, admin document indexing) ---
OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_MODEL=gpt-4o
# EMBEDDING_MODEL=text-embedding-3-small

# --- MinIO (defaults match docker-compose.yml) ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=askmak_minio
MINIO_SECRET_KEY=askmak_minio_secret
# MINIO_CONSOLE_URL=http://127.0.0.1:9001

MINIO_BUCKET_DOCUMENTS=documents
MINIO_BUCKET_UPLOADS=uploads
MINIO_BUCKET_EXPORTS=exports
MINIO_BUCKET_REFERENCE=reference

# --- SMTP (optional; omit SMTP_HOST to skip email) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="AskMak" <noreply@example.com>
# VERIFICATION_EMAIL=true
# SMTP_INBOX_URL=http://localhost:8025

# --- RAG / ops ---
# RAG_MIN_RETRIEVAL_SCORE=0.22
# RAG_LOG=1
# INGEST_MIN_CHUNK_WORDS=10

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_INBOX_URL=

ADMIN_EMAIL=admin@mak.ac.ug
ADMIN_PASSWORD=admin123

VERIFICATION_EMAIL=true
